  <diagram id="cpu-control" name="2 - Control and memory">
    <mxGraphModel dx="1600" dy="1240" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Control, partial access and required interfaces" style="text;html=0;align=left;fontSize=28;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="55" as="geometry" />
        </mxCell>
        <mxCell id="control" value="Controller -&gt; exact Top destinations&#10;next_pc_sel -&gt; next_pc MUX: 0=PC+4; 1=jb_pc&#10;jb_op1_sel -&gt; JB operand1: 0=PC; 1=rs1_data&#10;alu_op1_sel -&gt; ALU operand1: 0=rs1_data; 1=PC&#10;alu_op2_sel -&gt; ALU operand2: 0=rs2_data; 1=imm&#10;alu_opcode / alu_func3 / alu_func7 -&gt; ALU decode inputs&#10;im_w_en -&gt; IM.w_en; always 0000" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fce3d7;strokeColor=#446584;fontColor=#18334B;fontSize=18;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="150" width="1500" height="225" as="geometry" />
        </mxCell>
        <mxCell id="wb" value="Write-back control&#10;wb_en &amp;&amp; rst -&gt; RegFile.wb_en&#10;wb_sel=1 -&gt; ld_data_f&#10;wb_sel=0 and JAL/JALR -&gt; pc_plus4&#10;wb_sel=0 otherwise -&gt; alu_out&#10;rd_index selects destination; x0 remains zero" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8e1ff;strokeColor=#446584;fontColor=#18334B;fontSize=18;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="410" width="720" height="190" as="geometry" />
        </mxCell>
        <mxCell id="mem" value="Store and load positioning in Top&#10;byte_offset = alu_out[1:0]; byte_shift = offset * 8&#10;dm_address = {alu_out[31:2], 2'b00}&#10;dm_write_data = rs2_data &lt;&lt; byte_shift&#10;dm_mask = rst ? dm_w_en &lt;&lt; byte_offset : 0&#10;ld_data = dm_read_data &gt;&gt; byte_shift" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcf1df;strokeColor=#446584;fontColor=#18334B;fontSize=18;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="410" width="730" height="190" as="geometry" />
        </mxCell>
        <mxCell id="reset" value="Clock / reset / termination&#10;clk -&gt; Reg_PC, RegFile, IM, DM&#10;rst=0 -&gt; PC=0 and all registers=0 asynchronously&#10;rst=0 -&gt; DM write mask = 0000&#10;DM.halt directly drives Top.halt" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d8f3fa;strokeColor=#446584;fontColor=#18334B;fontSize=18;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="640" width="720" height="165" as="geometry" />
        </mxCell>
        <mxCell id="branch" value="Control transfer&#10;ALU.jump -&gt; Controller: branch comparison result&#10;branch: next_pc_sel = jump&#10;JAL / JALR: next_pc_sel = 1&#10;JALR target = {jb_out[31:1], 1'b0}" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0cf;strokeColor=#446584;fontColor=#18334B;fontSize=18;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="640" width="730" height="165" as="geometry" />
        </mxCell>
        <mxCell id="mask" value="Required memory cases and interface names&#10;Basic dm_w_en: SB=0001; SH=0011; SW=1111; non-store=0000&#10;Byte offsets 0/1/2/3; halfword offsets 0/1/2 (including 1); word offset 0; no cross-word access required.&#10;Required instances: PC / regfile / IM / DM; register array: regfile.registers&#10;Decoder opcode=inst[6:2] (5 bits); func7=inst[30] (1 bit).&#10;Source preserves IM.halt connected to im_halt_unused; handout asks for .halt() unconnected." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8e1ff;strokeColor=#446584;fontColor=#18334B;fontSize=18;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="850" width="1500" height="210" as="geometry" />
        </mxCell>
        <mxCell id="footer-37" value="These pages explain the supplied RTL; they are not evidence of a newly executed CPU test." style="text;html=0;align=left;fontSize=15;fontColor=#18334B;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="1130.0" width="1510" height="24" as="geometry" />
        </mxCell>
        <mxCell id="footer-38" value="Editable .drawio and SVG/PNG previews are generated from the same node and connector model." style="text;html=0;align=left;fontSize=15;fontColor=#18334B;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="1154.0" width="1510" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
